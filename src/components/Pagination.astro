---
export interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

// Generar enlaces de paginación
function generatePageLinks(currentPage: number, totalPages: number) {
  const links = [];
  const maxVisiblePages = 5;
  
  if (totalPages <= maxVisiblePages) {
    // Mostrar todas las páginas si hay pocas
    for (let i = 1; i <= totalPages; i++) {
      links.push(i);
    }
  } else {
    // Mostrar páginas alrededor de la actual
    let start = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
    let end = Math.min(totalPages, start + maxVisiblePages - 1);
    
    // Ajustar si estamos cerca del final
    if (end - start + 1 < maxVisiblePages) {
      start = Math.max(1, end - maxVisiblePages + 1);
    }
    
    // Agregar primera página si no está incluida
    if (start > 1) {
      links.push(1);
      if (start > 2) {
        links.push('...');
      }
    }
    
    // Agregar páginas del rango
    for (let i = start; i <= end; i++) {
      if (i !== 1 && i !== totalPages) {
        links.push(i);
      }
    }
    
    // Agregar última página si no está incluida
    if (end < totalPages) {
      if (end < totalPages - 1) {
        links.push('...');
      }
      links.push(totalPages);
    }
  }
  
  return links;
}

// Generar URL para una página específica
function getPageUrl(page: number): string {
  if (page === 1) {
    return '/blog';
  }
  return `/blog?page=${page}`;
}

const pageLinks = generatePageLinks(currentPage, totalPages);
---

{totalPages > 1 && (
  <div class="container mx-auto px-6 py-8">
    <div class="flex flex-col items-center gap-4">
      <!-- Información de paginación -->
      <div class="text-sm text-gray-600 dark:text-gray-400">
        Página {currentPage} de {totalPages} • {totalPages} páginas en total
      </div>
      
      <!-- Navegación -->
      <div class="flex items-center gap-2">
        <!-- Botón Anterior -->
        {currentPage > 1 && (
          <a 
            href={getPageUrl(currentPage - 1)}
            class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Anterior
          </a>
        )}
        
        <!-- Números de página -->
        <div class="flex items-center gap-1">
          {pageLinks.map((link, index) => (
            link === '...' ? (
              <span key={`ellipsis-${index}`} class="px-3 py-2 text-gray-500">...</span>
            ) : (
              <a 
                key={link}
                href={getPageUrl(link)}
                class={`px-3 py-2 rounded transition-colors ${
                  link === currentPage 
                    ? 'bg-blue-500 text-white' 
                    : 'bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600'
                }`}
              >
                {link}
              </a>
            )
          ))}
        </div>
        
        <!-- Botón Siguiente -->
        {currentPage < totalPages && (
          <a 
            href={getPageUrl(currentPage + 1)}
            class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors flex items-center gap-2"
          >
            Siguiente
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
)} 