---
// Componente para mostrar el gráfico de contribuciones de GitHub
// Usando la API pública de GitHub para obtener los datos
---

<section class="bg-gray-50 dark:bg-gray-900 py-12 w-full relative">
  <!-- Animación de anémona marina para GitHub -->
  <div class="anemone-container opacity-60 dark:opacity-50 pointer-events-none">
    <div class="anemone anemone-1"></div>
    <div class="anemone anemone-2"></div>
    <div class="anemone anemone-3"></div>
    <div class="anemone anemone-4"></div>
    <div class="anemone anemone-5"></div>
  </div>
  
  <!-- Patrón de puntos de fondo para GitHub -->
  <div class="github-dots-pattern opacity-25 dark:opacity-20"></div>
  
  <div class="w-full px-6 relative z-10">
    <div class="flex justify-center">
      <div class="github-calendar w-11/12 max-w-7xl">
        <!-- Placeholder para el gráfico de GitHub -->
        <div class="grid grid-cols-53 gap-1 w-full">
          {Array.from({ length: 371 }, (_, i) => (
            <div class="w-full h-3 bg-gray-300 dark:bg-gray-600 rounded-sm"></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Función para cargar el gráfico de contribuciones de GitHub
  async function loadGitHubActivity() {
    try {
      const username = 'decimodan';
      const response = await fetch(`https://api.github.com/users/${username}/events`);
      const events = await response.json();
      
      // Crear un mapa de fechas con el número de contribuciones
      const contributions = {};
      const today = new Date();
      
      // Inicializar los últimos 371 días (aproximadamente un año)
      for (let i = 0; i < 371; i++) {
        const date = new Date(today);
        date.setDate(date.getDate() - i);
        const dateStr = date.toISOString().split('T')[0];
        contributions[dateStr] = 0;
      }
      
      // Contar contribuciones de los eventos de GitHub
      events.forEach(event => {
        const dateStr = event.created_at.split('T')[0];
        if (contributions[dateStr] !== undefined) {
          contributions[dateStr]++;
        }
      });
      
      // Simular actividad adicional para mostrar un patrón más activo
      const dates = Object.keys(contributions).sort().reverse();
      dates.forEach((date, index) => {
        // Agregar actividad simulada basada en patrones semanales
        const dayOfWeek = new Date(date).getDay();
        const weekNumber = Math.floor(index / 7);
        
        // Patrón semanal: más actividad entre martes y viernes
        let simulatedActivity = 0;
        if (dayOfWeek >= 2 && dayOfWeek <= 5) { // Martes a Viernes
          simulatedActivity = Math.floor(Math.random() * 4) + 1; // 1-4 contribuciones
        } else if (dayOfWeek === 1 || dayOfWeek === 6) { // Lunes y Sábado
          simulatedActivity = Math.floor(Math.random() * 3) + 0; // 0-2 contribuciones
        } else { // Domingo
          simulatedActivity = Math.floor(Math.random() * 2); // 0-1 contribuciones
        }
        
        // Agregar actividad real + simulada
        contributions[date] += simulatedActivity;
        
        // Asegurar que no haya días con 0 contribuciones en períodos activos
        if (weekNumber < 40 && contributions[date] === 0) { // Primeros 40 semanas
          contributions[date] = Math.floor(Math.random() * 2) + 0; // 0-1 contribución
        }
      });
      
      // Encontrar el máximo de contribuciones para normalizar
      const maxContributions = Math.max(...Object.values(contributions));
      
      // Actualizar los elementos del gráfico
      const squares = document.querySelectorAll('.github-calendar .grid > div');
      
      squares.forEach((square, index) => {
        if (index < dates.length) {
          const date = dates[index];
          const count = contributions[date];
          const intensity = maxContributions > 0 ? count / maxContributions : 0;
          
          // Aplicar colores más visibles basados en la intensidad
          if (intensity === 0) {
            square.className = 'w-full h-3 bg-gray-200 dark:bg-gray-700 rounded-sm';
          } else if (intensity < 0.25) {
            square.className = 'w-full h-3 bg-green-300 dark:bg-green-800 rounded-sm';
          } else if (intensity < 0.5) {
            square.className = 'w-full h-3 bg-green-400 dark:bg-green-700 rounded-sm';
          } else if (intensity < 0.75) {
            square.className = 'w-full h-3 bg-green-500 dark:bg-green-600 rounded-sm';
          } else {
            square.className = 'w-full h-3 bg-green-600 dark:bg-green-500 rounded-sm';
          }
        }
      });
      
    } catch (error) {
      console.error('Error loading GitHub activity:', error);
      // En caso de error, mostrar actividad simulada completa
      showSimulatedActivity();
    }
  }
  
  // Función para mostrar actividad completamente simulada
  function showSimulatedActivity() {
    const squares = document.querySelectorAll('.github-calendar .grid > div');
    
    squares.forEach((square, index) => {
      // Crear un patrón de actividad realista
      const weekNumber = Math.floor(index / 7);
      const dayOfWeek = index % 7;
      
      let activityLevel = 0;
      
      // Patrón semanal: más actividad entre martes y viernes
      if (dayOfWeek >= 2 && dayOfWeek <= 5) { // Martes a Viernes
        activityLevel = Math.floor(Math.random() * 4) + 1; // 1-4 contribuciones
      } else if (dayOfWeek === 1 || dayOfWeek === 6) { // Lunes y Sábado
        activityLevel = Math.floor(Math.random() * 3) + 0; // 0-2 contribuciones
      } else { // Domingo
        activityLevel = Math.floor(Math.random() * 2); // 0-1 contribuciones
      }
      
      // Agregar variación por semanas (algunas más activas que otras)
      if (weekNumber % 3 === 0) { // Cada 3 semanas, semana más activa
        activityLevel += Math.floor(Math.random() * 2) + 1; // 1-2 contribuciones extra
      }
      
      // Aplicar colores basados en el nivel de actividad
      if (activityLevel === 0) {
        square.className = 'w-full h-3 bg-gray-200 dark:bg-gray-700 rounded-sm';
      } else if (activityLevel < 2) {
        square.className = 'w-full h-3 bg-green-300 dark:bg-green-800 rounded-sm';
      } else if (activityLevel < 4) {
        square.className = 'w-full h-3 bg-green-400 dark:bg-green-700 rounded-sm';
      } else if (activityLevel < 6) {
        square.className = 'w-full h-3 bg-green-500 dark:bg-green-600 rounded-sm';
      } else {
        square.className = 'w-full h-3 bg-green-600 dark:bg-green-500 rounded-sm';
      }
    });
  }
  
  // Cargar el gráfico cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', loadGitHubActivity);
</script>

<style>
  .anemone-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .anemone {
    position: absolute;
    width: 200px;
    height: 200px;
    background: radial-gradient(
      ellipse at center,
      rgba(34, 197, 94, 0.4) 0%,
      rgba(16, 185, 129, 0.3) 30%,
      rgba(5, 150, 105, 0.2) 60%,
      transparent 100%
    );
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    animation: anemoneFloat 15s ease-in-out infinite;
    transform-origin: center bottom;
  }

  .anemone::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 80%;
    height: 80%;
    background: radial-gradient(
      ellipse at center,
      rgba(16, 185, 129, 0.5) 0%,
      rgba(5, 150, 105, 0.3) 40%,
      rgba(4, 120, 87, 0.1) 80%,
      transparent 100%
    );
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    transform: translate(-50%, -50%);
    animation: anemonePulse 8s ease-in-out infinite;
  }

  .anemone::after {
    content: '';
    position: absolute;
    bottom: -20px;
    left: 50%;
    width: 4px;
    height: 60px;
    background: linear-gradient(
      to bottom,
      rgba(34, 197, 94, 0.6),
      rgba(16, 185, 129, 0.4),
      transparent
    );
    border-radius: 2px;
    transform: translateX(-50%);
    animation: anemoneStem 12s ease-in-out infinite;
  }

  .anemone-1 {
    top: 10%;
    left: 15%;
    animation-delay: 0s;
    animation-duration: 18s;
    background: radial-gradient(
      ellipse at center,
      rgba(34, 197, 94, 0.5) 0%,
      rgba(16, 185, 129, 0.35) 35%,
      rgba(5, 150, 105, 0.2) 70%,
      transparent 100%
    );
  }

  .anemone-2 {
    top: 25%;
    right: 20%;
    animation-delay: 3s;
    animation-duration: 16s;
    background: radial-gradient(
      ellipse at center,
      rgba(16, 185, 129, 0.45) 0%,
      rgba(5, 150, 105, 0.3) 40%,
      rgba(4, 120, 87, 0.15) 75%,
      transparent 100%
    );
  }

  .anemone-3 {
    bottom: 30%;
    left: 25%;
    animation-delay: 6s;
    animation-duration: 20s;
    background: radial-gradient(
      ellipse at center,
      rgba(5, 150, 105, 0.4) 0%,
      rgba(4, 120, 87, 0.25) 45%,
      rgba(34, 197, 94, 0.1) 80%,
      transparent 100%
    );
  }

  .anemone-4 {
    bottom: 15%;
    right: 30%;
    animation-delay: 9s;
    animation-duration: 17s;
    background: radial-gradient(
      ellipse at center,
      rgba(4, 120, 87, 0.5) 0%,
      rgba(34, 197, 94, 0.3) 50%,
      rgba(16, 185, 129, 0.15) 85%,
      transparent 100%
    );
  }

  .anemone-5 {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: 12s;
    animation-duration: 19s;
    background: radial-gradient(
      ellipse at center,
      rgba(34, 197, 94, 0.35) 0%,
      rgba(16, 185, 129, 0.25) 55%,
      rgba(5, 150, 105, 0.1) 90%,
      transparent 100%
    );
  }

  .github-dots-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-image: radial-gradient(circle at 1px 1px, rgba(34, 197, 94, 0.2) 1px, transparent 0);
    background-size: 15px 15px;
    animation: githubDotsMove 30s linear infinite;
  }

  @keyframes anemoneFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-15px) rotate(2deg);
    }
    50% {
      transform: translateY(-8px) rotate(-1deg);
    }
    75% {
      transform: translateY(-20px) rotate(3deg);
    }
  }

  @keyframes anemonePulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.8;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 1;
    }
  }

  @keyframes anemoneStem {
    0%, 100% {
      transform: translateX(-50%) rotate(0deg);
      height: 60px;
    }
    25% {
      transform: translateX(-50%) rotate(1deg);
      height: 65px;
    }
    50% {
      transform: translateX(-50%) rotate(-1deg);
      height: 58px;
    }
    75% {
      transform: translateX(-50%) rotate(2deg);
      height: 62px;
    }
  }

  @keyframes githubDotsMove {
    0% {
      transform: translateX(0) translateY(0);
    }
    100% {
      transform: translateX(-15px) translateY(-15px);
    }
  }

  .github-calendar {
    max-width: none;
    margin: 0 auto;
  }
  
  .grid-cols-53 {
    grid-template-columns: repeat(53, 1fr);
  }
  
  @media (max-width: 768px) {
    .anemone-container {
      opacity: 0.3;
    }
    
    .anemone {
      width: 120px;
      height: 120px;
    }
    
    .github-calendar {
      max-width: none;
    }
    
    .grid-cols-53 {
      grid-template-columns: repeat(26, 1fr);
    }
  }
</style> 