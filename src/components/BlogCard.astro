---
export interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description: string;
      thumbnail?: string;
      pubDate: Date;
    };
  };
}

const { post } = Astro.props;

// Safe access to post properties
const slug = post?.slug || 'unknown';
const data = post?.data || {};
const title = data?.title || 'Sin título';
const description = data?.description || 'Sin descripción';
const thumbnail = data?.thumbnail;
const pubDate = data?.pubDate || new Date();
---

<a class="p-2" href={`/blog/${slug}`}>
  {thumbnail && (
    <div class="relative">
      <img src={thumbnail} alt={title} class="rounded-lg shadow-sm w-full h-52 object-cover" />
      <div class="absolute top-4 right-4 rounded shadow bg-white text-gray-900 dark:bg-gray-900 dark:text-white text-sm px-2 py-0.5">
        {pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: '2-digit' })}
      </div>
    </div>
  )}
  <div class="my-2 text-xl font-semibold">{title}</div>
  <div class="">{description}</div>
</a> 