---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import Skills from '../components/Skills.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import BlogCard from '../components/BlogCard.astro';

// Cargar todos los posts del directorio de contenido
const postFiles = await Astro.glob('../content/blog/**/*.md');

// Transformar los posts a la estructura esperada
const posts = await Promise.all(
  postFiles.map(async (post) => {
    try {
      // Extraer el slug de la ruta del archivo
      const pathParts = post.file.split('/');
      
      let year, filename, slug;
      
      // Verificar si el archivo está en un subdirectorio por año o en el directorio raíz
      if (pathParts.length >= 4 && /^\d{4}$/.test(pathParts[pathParts.length - 2])) {
        // Archivo en subdirectorio por año (ej: src/content/blog/2019/post.md)
        year = pathParts[pathParts.length - 2];
        filename = pathParts[pathParts.length - 1].split('.')[0];
        slug = `${year}-${filename}`;
      } else {
        // Archivo en el directorio raíz (ej: src/content/blog/post.md)
        // Intentar extraer el año del frontmatter o usar un año por defecto
        const pubDate = post.frontmatter?.pubDate ? new Date(post.frontmatter.pubDate) : new Date();
        year = pubDate.getFullYear().toString();
        filename = pathParts[pathParts.length - 1].split('.')[0];
        slug = `${year}-${filename}`;
      }
      
      return {
        slug,
        data: {
          title: post.frontmatter?.title || 'Sin título',
          description: post.frontmatter?.description || post.frontmatter?.summary || 'Sin descripción',
          thumbnail: post.frontmatter?.thumbnail || post.frontmatter?.image || '/blog-placeholder-1.jpg',
          pubDate: post.frontmatter?.pubDate ? new Date(post.frontmatter.pubDate) : new Date()
        }
      };
    } catch (error) {
      console.error(`Error processing post: ${post.file}`, error);
      return null;
    }
  })
);

// Filtrar posts nulos y ordenar por fecha
const validPosts = posts.filter(Boolean);
const sortedPosts = validPosts.sort((a, b) => 
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Obtener los 6 posts más recientes
const recentPosts = sortedPosts.slice(0, 6);
---

<BaseLayout title="Home">
  <Intro />
  <Skills />
  <GitHubActivity />
  
  <div class="container p-6 mx-auto">
    <h2 class="text-3xl font-bold text-center mb-8 text-gray-900 dark:text-white">Últimos Posts</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-8">
      {recentPosts.map(post => (
        <BlogCard post={post} />
      ))}
    </div>
  </div>

  {sortedPosts.length > 6 && (
    <div class="text-center mb-8">
      <a class="px-8 py-3 rounded transition-colors bg-blue-100 text-gray-500 hover:text-gray-800 dark:bg-gray-900 dark:text-gray-400 dark:hover:text-white" href="/blog">
        Ver todos
      </a>
    </div>
  )}
</BaseLayout>
